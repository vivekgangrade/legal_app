# ============================================================
# Legal AI Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env   (Linux/Mac)
#   copy .env.example .env (Windows)
# ============================================================

# ── API Keys (REQUIRED) ─────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Environment ──────────────────────────────────────────────
# "development" or "production"
APP_ENV=development

# ── Server ───────────────────────────────────────────────────
# Port for Gradio to listen on
PORT=10000

# ── Logging ──────────────────────────────────────────────────
# DEBUG, INFO, WARNING, ERROR, CRITICAL
# Production auto-defaults to WARNING if not set
LOG_LEVEL=INFO

# ── API Timeout ──────────────────────────────────────────────
# Seconds before LLM/search API calls timeout
API_TIMEOUT=30

# ── Workers ──────────────────────────────────────────────────
# Number of Gunicorn workers (production only)
WORKERS=1

# ── Basic Auth (Optional, production only) ───────────────────
# Set both to enable Gradio basic auth in production.
# Leave blank to disable.
GRADIO_AUTH_USER=
GRADIO_AUTH_PASS=

# ── LLM Model (Optional) ────────────────────────────────────
# LLM_MODEL_NAME=llama-3.1-8b-instant
# LLM_TEMPERATURE=0.0

# ── RAG Settings (Optional) ─────────────────────────────────
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# RAG_TOP_K=3

# ── Search Settings (Optional) ──────────────────────────────
# SEARCH_DEPTH=advanced
# MAX_SEARCH_RESULTS=5
